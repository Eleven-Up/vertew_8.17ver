# Keep Kiro spec/steering files tracked (do NOT ignore .kiro)

# Locally-installed third-party agent skills (e.g. `npx skills add ...`) -- these
# run with full agent permissions and some ship flagged High/Critical risk by the
# installer's own scanner, so they stay local rather than shared via the repo.
backend/.agents/
backend/.claude/
backend/skills-lock.json

# Runtime state written by scripts/windows/start-vertew.ps1 (tracked PIDs / URL
# of the current local run) -- machine-specific, regenerated every start.
/vertew-run.json
/vertew-url.txt
