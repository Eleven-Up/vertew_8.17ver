{
  "name": "vertew-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Vertew Kiosk_UI: character rendering, Speech_Module (STT/TTS), and the conversation state machine.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "esbuild js/main.ts js/mock.ts --bundle --format=esm --target=es2020 --outdir=js",
    "build:watch": "esbuild js/main.ts js/mock.ts --bundle --format=esm --target=es2020 --outdir=js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fast-check": "^3.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "animejs": "^4.5.0",
    "qrcode": "^1.5.4"
  }
}
