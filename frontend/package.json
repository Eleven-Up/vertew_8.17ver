{
  "name": "vertew-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Vertew Kiosk_UI: character rendering, Speech_Module (STT/TTS), and the conversation state machine.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "esbuild js/main.ts --bundle --format=esm --target=es2020 --outfile=js/main.js",
    "build:watch": "esbuild js/main.ts --bundle --format=esm --target=es2020 --outfile=js/main.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
