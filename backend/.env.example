# Copy to backend/.env and fill in. Never commit the real .env file.

# Which LLM backend to use:
#   "gemini"   - Google Gemini directly (cloud)
#   "factchat" - CNU API Gateway (cloud, OpenAI-compatible)
#   "local"    - fully-offline OpenAI-compatible server on the device (no key)
LLM_PROVIDER=gemini

# --- local (fully offline; used when LLM_PROVIDER=local) ---
# Point at a local OpenAI-compatible server. Examples:
#   Ollama:            LOCAL_LLM_BASE_URL=http://localhost:11434/v1
#   llama.cpp server:  LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# LOCAL_LLM_MODEL is the served model tag/name (e.g. an Ollama tag). Pick a small
# multilingual instruct model that fits the device RAM (see docs/ops for the Pi).
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:1.5b-instruct
# Most local servers need no key; set one only if your server enforces it.
LOCAL_LLM_API_KEY=

# --- QA retrieval (which curated Q&A entries get injected into the prompt) ---
# "hashing" (default): zero-dependency lexical ranking, no model download.
# "fastembed": multilingual semantic embeddings via the ONNX `fastembed` package
#   (pip install fastembed) — enables cross-lingual matching, Raspberry-Pi-viable.
QA_EMBEDDER=hashing
QA_EMBED_MODEL=intfloat/multilingual-e5-small
# Max number of curated answers injected into the prompt per turn.
QA_TOP_K=6

# --- factchat / CNU API Gateway (OpenAI-compatible) ---
# A universal gateway exposing OpenAI/Anthropic/Google/xAI models behind one key.
FACTCHAT_API_KEY=your-cnu-api-key-here
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
FACTCHAT_MODEL=gemini-2.5-flash

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
# Google Gemini API key (from Google AI Studio, free tier).
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Path to the local SQLite database file.
VERTEW_DB_PATH=vertew.db

# Public base URL used later when session-aware QR links are generated.
PUBLIC_APP_URL=http://localhost:8000
STORE_ID=demo
VERTEW_DEBUG_MODE=true
SENSOR_SHARED_SECRET=
ESP32_SERIAL_PORT=/dev/ttyUSB0
ESP32_BAUDRATE=115200
SENSOR_TRIGGER_PIN=23
SENSOR_ECHO_PIN=24
