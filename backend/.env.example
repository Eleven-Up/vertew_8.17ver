# Copy to backend/.env and fill in. Never commit the real .env file.

# Which LLM backend to use: "gemini" (Google direct) or "factchat" (CNU Gateway).
LLM_PROVIDER=gemini

# --- factchat / CNU API Gateway (OpenAI-compatible) ---
# A universal gateway exposing OpenAI/Anthropic/Google/xAI models behind one key.
FACTCHAT_API_KEY=your-cnu-api-key-here
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
FACTCHAT_MODEL=gemini-2.5-flash

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
# Google Gemini API key (from Google AI Studio, free tier).
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Path to the local SQLite database file.
VERTEW_DB_PATH=vertew.db
